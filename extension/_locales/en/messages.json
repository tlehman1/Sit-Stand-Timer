{
  "extName": {
    "message": "Sit-Stand Timer",
    "description": "Name of the extension."
  },
  "localCopy": { "message": "local copy" },
  "extDescription": {
    "message": "Reminds you to alternate between sitting and standing at your height-adjustable desk – with the countdown right on the icon.",
    "description": "Short description, at most 132 characters."
  },

  "phaseSit": { "message": "Sitting" },
  "phaseStand": { "message": "Standing" },
  "phaseGroupLabel": { "message": "Current position" },

  "captionIdle": { "message": "Ready" },
  "captionSit": { "message": "sitting time left" },
  "captionStand": { "message": "standing time left" },
  "captionPaused": { "message": "Paused" },
  "captionOtherSit": {
    "message": "Sitting: $MINUTES$ min left",
    "placeholders": { "minutes": { "content": "$1", "example": "32" } }
  },
  "captionOtherStand": {
    "message": "Standing: $MINUTES$ min left",
    "placeholders": { "minutes": { "content": "$1", "example": "12" } }
  },

  "btnStart": { "message": "Start" },
  "btnPause": { "message": "Pause" },
  "btnResume": { "message": "Resume" },
  "btnStop": { "message": "Stop" },
  "btnStopTimer": { "message": "Stop timer" },
  "btnOk": { "message": "OK" },
  "btnDone": { "message": "Done – start timer" },
  "btnDoneShort": { "message": "Done" },
  "btnSnooze": {
    "message": "Remind me in $MINUTES$ min",
    "placeholders": { "minutes": { "content": "$1", "example": "5" } }
  },
  "btnSnoozeShort": {
    "message": "$MINUTES$ min later",
    "placeholders": { "minutes": { "content": "$1", "example": "5" } }
  },

  "promptStandTitle": { "message": "Time to stand up!" },
  "promptStandText": { "message": "Raise your desk." },
  "promptSitTitle": { "message": "Time to sit down!" },
  "promptSitText": { "message": "Lower your desk." },
  "promptNextStand": {
    "message": "Up next: $MINUTES$ min standing",
    "placeholders": { "minutes": { "content": "$1", "example": "15" } }
  },
  "promptNextSit": {
    "message": "Up next: $MINUTES$ min sitting",
    "placeholders": { "minutes": { "content": "$1", "example": "45" } }
  },
  "promptRunningStand": {
    "message": "Your $MINUTES$ min of standing have already started.",
    "placeholders": { "minutes": { "content": "$1", "example": "15" } }
  },
  "promptRunningSit": {
    "message": "Your $MINUTES$ min of sitting have already started.",
    "placeholders": { "minutes": { "content": "$1", "example": "45" } }
  },

  "settingsTitle": { "message": "Settings" },
  "settingSit": { "message": "Sitting" },
  "settingStand": { "message": "Standing" },
  "unitMinutes": { "message": "min" },
  "btnResetDurations": {
    "message": "Restore default durations ($SIT$ min sitting, $STAND$ min standing)",
    "placeholders": {
      "sit": { "content": "$1", "example": "45" },
      "stand": { "content": "$2", "example": "15" }
    }
  },
  "settingDurationHint": { "message": "New durations apply from the next phase." },
  "settingSound": { "message": "Sound" },
  "settingVolume": { "message": "Volume" },
  "btnTestSound": { "message": "Play test sound" },
  "settingAutoStart": { "message": "Start next phase automatically" },
  "settingAutoStartHint": { "message": "Off: the timer waits until you confirm the change." },
  "settingStretch": { "message": "Stretching exercises" },
  "settingStretchHint": { "message": "On: after every change the timer shows you a short exercise." },

  "btnStretchDone": { "message": "Done" },
  "notifyStretch": {
    "message": "Then: $EXERCISE$",
    "placeholders": { "exercise": { "content": "$1", "example": "Neck stretch" } }
  },
  "stretch_neck_title": { "message": "Neck stretch" },
  "stretch_neck_text": { "message": "Slowly tilt your head to one side and keep your shoulders down." },
  "stretch_neck_hint": { "message": "about 20 seconds per side" },
  "stretch_shoulders_title": { "message": "Shoulder rolls" },
  "stretch_shoulders_text": { "message": "Pull your shoulders up and roll them back and down." },
  "stretch_shoulders_hint": { "message": "10 times, slowly" },
  "stretch_reach_title": { "message": "Overhead reach" },
  "stretch_reach_text": { "message": "Stretch both arms above your head and make yourself tall." },
  "stretch_reach_hint": { "message": "hold for about 20 seconds" },
  "stretch_sidebend_title": { "message": "Side bend" },
  "stretch_sidebend_text": { "message": "Raise one arm above your head and lean to the other side." },
  "stretch_sidebend_hint": { "message": "about 20 seconds per side" },
  "stretch_crossarm_title": { "message": "Shoulder stretch" },
  "stretch_crossarm_text": { "message": "Pull one arm across your chest and hold it with the other hand." },
  "stretch_crossarm_hint": { "message": "about 20 seconds per side" },
  "stretch_calfraise_title": { "message": "Calf raises" },
  "stretch_calfraise_text": { "message": "Push up onto your toes, hold briefly and lower slowly." },
  "stretch_calfraise_hint": { "message": "10 times, slowly" },
  "stretch_kneehug_title": { "message": "Knee to chest" },
  "stretch_kneehug_text": { "message": "Pull one knee to your chest with both hands and keep your back straight." },
  "stretch_kneehug_hint": { "message": "about 20 seconds per side" },

  "tooltipSit": {
    "message": "Sitting – $MINUTES$ min left",
    "placeholders": { "minutes": { "content": "$1", "example": "45" } }
  },
  "tooltipStand": {
    "message": "Standing – $MINUTES$ min left",
    "placeholders": { "minutes": { "content": "$1", "example": "15" } }
  },
  "tooltipPaused": {
    "message": "Paused – $MINUTES$ min left",
    "placeholders": { "minutes": { "content": "$1", "example": "12" } }
  }
}
